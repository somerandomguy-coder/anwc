{
  "name": "anwc",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "vite examples/shop",
    "build": "node scripts/build.js",
    "typecheck": "tsc --build",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:integration": "npm run typecheck && npm run test:unit && npm run test:browser && npm run build",
    "anwc": "tsx packages/cli/src/main.ts",
    "bench": "tsx packages/benchmark/src/main.ts",
    "pack:packages": "node scripts/pack.js"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.7"
  }
}
